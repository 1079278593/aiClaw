# 复制为同目录 fir.env（已 gitignore），填入真实 token：
#   cp scripts/fir.env.example scripts/fir.env
#
# fir / betaqr 控制台 → 账户设置 → API Token（32 位）

FIR_API_TOKEN=your_32_char_api_token_here

# 可选：上传时在 fir 显示的应用名
FIR_APP_NAME=aiClaw

# 可选：固定营销版本号（三位 x.y.z），build 仍由脚本每次发布 +1
# 不设则沿用 pubspec.yaml 里当前的 x.y.z
# FIR_MARKETING_VERSION=1.0.0

# 与工程一致（一般不用改）。本项目只有 iOS。
IOS_BUNDLE_ID=com.aiclaw.aiclawMobile

# iOS 上传到 fir 必须是 Adhoc 或 Inhouse，对应 export-method
# ad-hoc | enterprise（企业/Inhouse）
IOS_EXPORT_METHOD=ad-hoc
